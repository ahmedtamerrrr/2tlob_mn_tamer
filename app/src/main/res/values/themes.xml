<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.OtlobMenTamer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/bun_deep</item>
        <item name="android:colorControlActivated">@color/bun_deep</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.Otlob.Field" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_hint</item>
    </style>

    <style name="Widget.Otlob.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Otlob.Button.Secondary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Text.Otlob" parent="android:Widget.TextView" />

    <style name="Text.Otlob.Title">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Text.Otlob.Subtitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
</resources>